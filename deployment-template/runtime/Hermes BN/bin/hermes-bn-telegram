#!/bin/bash
set -e
source '__HERMES_BN_ROOT__/environment.sh'
label='ai.hermes.gateway-8a645bf9'
target="gui/$(id -u)/$label"
definition="$HERMES_BN_ROOT/services/$label.plist"
case "${1:-status}" in
  start)
    if ! launchctl print "$target" >/dev/null 2>&1; then
      launchctl bootstrap "gui/$(id -u)" "$definition"
    fi
    launchctl kickstart "$target"
    ;;
  stop)
    if launchctl print "$target" >/dev/null 2>&1; then
      launchctl bootout "$target"
    fi
    ;;
  restart)
    if launchctl print "$target" >/dev/null 2>&1; then
      launchctl kickstart -k "$target"
    else
      exec "$0" start
    fi
    ;;
  status)
    if ! launchctl print "$target" > "$HERMES_BN_ROOT/tmp/telegram-service-status.txt" 2>/dev/null; then
      printf 'Служба Telegram остановлена.\n'
      exit 1
    fi
    awk '/^[[:space:]]*(state|pid|runs|last exit code) =/ {print}' "$HERMES_BN_ROOT/tmp/telegram-service-status.txt"
    ;;
  *)
    printf 'Использование: hermes-bn-telegram [start|stop|restart|status]\n'
    exit 2
    ;;
esac
