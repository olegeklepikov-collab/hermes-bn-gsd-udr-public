{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GSD host policy 1",
  "type": "object",
  "properties": {
    "contract": {
      "const": "gsd.host-policy/1"
    },
    "procedure_executors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "components": {
            "type": "array",
            "items": {
              "enum": [
                "G",
                "S",
                "D"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "key_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "enabled",
          "components",
          "key_file"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "procedure_executors"
  ],
  "additionalProperties": false
}
