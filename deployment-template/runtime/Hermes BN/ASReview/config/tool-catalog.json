{
  "service_status": {
    "description": "Проверить местную установку ASReview, модели, каталоги и состояние LAB.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "model_catalog": {
    "description": "Получить выбранные модели и их точные параметры; составные модели ASReview доступны отдельно.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "inspect_dataset": {
    "description": "Проверить местный CSV/RIS/XLSX/TSV/JSON: поля, пропуски, метки и повторы названий.",
    "input_schema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    }
  },
  "prepare_dataset": {
    "description": "Создать нормализованную копию данных CSV; исходный файл сохраняется. Не превращает пропуски в исключения.",
    "input_schema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "create_project": {
    "description": "Создать отдельный местный обзор или проверку ранее заданных меток; требуется протокол критериев перед реальными решениями.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "oracle",
            "validate"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "project_id",
        "file"
      ],
      "additionalProperties": false
    }
  },
  "list_projects": {
    "description": "Перечислить местные проекты ASReview без чтения статей.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "project_info": {
    "description": "Получить параметры проекта, происхождение данных, модель и ход отбора.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "list_records": {
    "description": "Прочитать ограниченную страницу импортированных названий и аннотаций с метками.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "filter": {
          "type": "string",
          "enum": [
            "all",
            "unseen",
            "relevant",
            "irrelevant"
          ]
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "get_record": {
    "description": "Прочитать одну импортированную запись, историю решения и заметку; полный текст не загружается.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project_id",
        "record_id"
      ],
      "additionalProperties": false
    }
  },
  "set_protocol": {
    "description": "Сохранить вопрос, критерии включения/исключения, этап и правила проверки и остановки. Не меняет научных решений.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 100
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 100
            },
            "stage": {
              "type": "string",
              "enum": [
                "title_abstract",
                "full_text",
                "documents"
              ]
            },
            "stop_rule": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_policy": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "question",
            "include",
            "exclude",
            "stage",
            "stop_rule",
            "reviewer_policy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "project_id",
        "protocol"
      ],
      "additionalProperties": false
    }
  },
  "get_protocol": {
    "description": "Прочитать сохранённый протокол отбора.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "configure_model": {
    "description": "Выбрать подготовленную модель и начальное состояние генератора; прежние решения сохраняются.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "project_id",
        "model"
      ],
      "additionalProperties": false
    }
  },
  "train_rank": {
    "description": "Обучить модель по существующим двум классам и обновить приоритеты. Вероятности не означают научную достоверность.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "next_records": {
    "description": "Получить очередные неразмеченные уникальные записи по последнему ранжированию; решения не записываются.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "propose_decisions": {
    "description": "Сохранить предложения агента отдельно от подтверждённых меток; обучение по предложениям не запускается.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "enum": [
                  "relevant",
                  "irrelevant"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "record_id",
              "label",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id",
        "decisions",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "record_decision": {
    "description": "Записать или исправить явно заданное человеком решение либо синтетическую проверку; сохраняются причина, этап и история. Совпадающие записи получают общее решение ASReview.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "enum": [
            "relevant",
            "irrelevant"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "enum": [
            "human",
            "synthetic_test"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 30
        }
      },
      "required": [
        "project_id",
        "record_id",
        "label",
        "reason",
        "actor"
      ],
      "additionalProperties": false
    }
  },
  "progress": {
    "description": "Получить количества исходных/уникальных/размеченных записей и ограничения оценки полноты.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "decision_history": {
    "description": "Прочитать изменения решений ASReview и журнал действий Hermes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "sample_audit": {
    "description": "Получить воспроизводимую случайную выборку ещё не просмотренных уникальных записей; ничего не исключать.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "export_dataset": {
    "description": "Сохранить отбор в CSV/TSV/XLSX/JSON/RIS и отдельные исходные поля с историей; нерешённые записи остаются пустыми.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "tsv",
            "xlsx",
            "json",
            "ris"
          ]
        },
        "filter": {
          "type": "string",
          "enum": [
            "all",
            "relevant",
            "irrelevant",
            "unseen"
          ]
        },
        "include_duplicates": {
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "format"
      ],
      "additionalProperties": false
    }
  },
  "export_project": {
    "description": "Сохранить переносимую копию проекта .asreview с настройками, данными и решениями.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "import_project": {
    "description": "Импортировать копию архива .asreview под новым идентификатором; исходный проект сохраняется, исполняемые файлы не принимаются.",
    "input_schema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "simulate": {
    "description": "Смоделировать отбор на полностью размеченных данных с заданными моделью, начальными примерами и ограничением просмотра.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "stop": {
          "type": "string",
          "enum": [
            "all",
            "last_relevant",
            "n_labelled",
            "consecutive_irrelevant"
          ]
        },
        "stop_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "project_id",
        "file"
      ],
      "additionalProperties": false
    }
  },
  "simulation_report": {
    "description": "Рассчитать фактически найденную долю релевантных записей и затраты просмотра только для полностью размеченного моделирования.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "compare_decisions": {
    "description": "Сравнить текущие решения с исходными метками для режима проверки; согласие не доказывает правильность критериев.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "set_review_status": {
    "description": "Отметить обзор завершённым либо возобновить; это не подтверждает полноту найденных исследований.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "review",
            "finished"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id",
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "plot_progress": {
    "description": "Создать изображение накопленного числа включённых записей по порядку подтверждённых решений.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  },
  "read_documentation": {
    "description": "Прочитать ограниченный фрагмент сохранённой официальной инструкции ASReview 3.0.8.",
    "input_schema": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 100,
          "maximum": 15000
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": false
    }
  },
  "create_demo": {
    "description": "Создать отдельный синтетический набор и проект для проверки интерфейса; научных публикаций в нём нет.",
    "input_schema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    }
  }
}
