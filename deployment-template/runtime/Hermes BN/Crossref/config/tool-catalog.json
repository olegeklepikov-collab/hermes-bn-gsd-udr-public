        "sort": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "select": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "journals",
            "members",
            "funders",
            "prefixes",
            "types"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "facets": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              {
                "type": "string",
                "enum": [
                  "*"
                ]
              }
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
